# URL base da API Timbas (sem barra no final)
NEXT_PUBLIC_API_URL=http://localhost:3333

# Endereço interno da API, usado só pelo servidor Next no SSR.
# Sem ele o server component chama a API pelo domínio público, o que faz o
# request sair para a internet e voltar mesmo com os dois na mesma máquina.
# Ex.: http://host.docker.internal:3333 (Docker) ou http://127.0.0.1:3333
API_INTERNAL_URL=
